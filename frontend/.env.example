# AEGIS-IDPS Frontend Environment Configuration

# Production Backend API URL (leave blank for local dev proxying /api)
# Example: https://aegis-idps-api.onrender.com
VITE_API_URL=

# Production WebSocket URL (leave blank to auto-derive from VITE_API_URL or local proxy)
# Example: wss://aegis-idps-api.onrender.com/ws/events
VITE_WS_URL=

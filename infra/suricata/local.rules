# IDPS Core Detection Rules
alert tcp any any -> $HOME_NET 22 (msg:"ET SCAN Potential SSH Brute Force Attack"; flow:to_server; flags:S; threshold:type both, track by_src, count 5, seconds 30; classtype:attempted-admin; sid:2000001; rev:1;)
alert tcp any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"ET WEB_SPECIFIC_APPS SQL Injection Attempt in URI"; flow:to_server,established; content:"UNION"; nocase; http_uri; content:"SELECT"; nocase; http_uri; classtype:web-application-attack; sid:2000002; rev:1;)
alert tcp any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"ET EXPLOIT Remote Command Execution Shell Spawn Attempt"; flow:to_server,established; content:"/bin/sh"; nocase; http_uri; classtype:attempted-admin; sid:2000003; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"ET SCAN Nmap Scripting Engine User-Agent"; flow:to_server; content:"Nmap"; http_header; classtype:web-application-attack; sid:2000004; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"ET SCAN SYN Port Scan Detected"; flags:S; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:2000005; rev:1;)
alert tcp any any -> $HOME_NET 445 (msg:"ET EXPLOIT SMB Ghost Remote Code Execution Attempt"; flow:to_server,established; content:"|fe|SMB"; classtype:trojan-activity; sid:2000006; rev:1;)
alert tcp any any -> $HOME_NET 3389 (msg:"ET SCAN RDP Scan Detected"; flags:S; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-recon; sid:2000007; rev:1;)

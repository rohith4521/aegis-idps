# Intelligent IDPS Environment Configuration
PROJECT_NAME="Intelligent IDPS"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT
SECRET_KEY="idps_super_secret_jwt_key_development_only_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# For SQLite (zero-config local run): sqlite:///./idps.db
# For PostgreSQL: postgresql+psycopg2://idps:idps_secure_password@localhost:5432/idps_db
DATABASE_URL="sqlite:///./idps.db"

# Suricata Detection Integration
SURICATA_EVE_PATH="./infra/suricata/eve.json"
DEMO_MODE=true

# Prevention Engine Policy
PREVENTION_PROVIDER="mock"
PREVENTION_ENABLED=true
AUTO_PREVENTION_THRESHOLD=80
DEFAULT_BLOCK_DURATION_MINUTES=60

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
